# Public domain
APP_DOMAIN=bentum.example.com
WEB_APP_URL=https://bentum.example.com
FRONTEND_BIND_PORT=8080
APP_VERSION=

# Frontend build-time variables
VITE_API_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=9
TELEGRAM_INTERNAL_API_TOKEN=replace-with-random-token

# Django
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=backend.settings
DJANGO_SECRET_KEY=replace-with-long-random-secret
DEBUG=False
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=bentum.example.com
CORS_ALLOWED_ORIGINS=https://bentum.example.com
CSRF_TRUSTED_ORIGINS=https://bentum.example.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Database
DATABASE_ENGINE=mysql
DATABASE_NAME=bentum
DATABASE_USERNAME=bentum
DATABASE_PASSWORD=replace-with-random-db-password
DATABASE_ROOT_PASSWORD=replace-with-random-root-password
DATABASE_HOST=db
DATABASE_PORT=3306
REDIS_URL=redis://redis:6379/0

# Security / limits
TWOFA_CODE_TTL_SECONDS=300
TWOFA_VERIFY_MAX_ATTEMPTS=6
TWOFA_RESEND_COOLDOWN_SECONDS=60
BACKGROUND_JOB_STALE_TIMEOUT_SECONDS=1800
TRUST_X_FORWARDED_FOR=True
SCHEDULE_SYNC_MIN_ENTRIES=1
SCHEDULE_SYNC_MIN_EXISTING_RATIO=0.5
BNTU_ALLOW_INSECURE_SSL=

# Optional Django admin bootstrap.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-random-admin-password
