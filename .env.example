# Frontend
# Leave empty for Docker Compose. For local frontend outside Docker you can set:
# VITE_API_URL=http://localhost:1337
VITE_API_URL=
VITE_WS_PATH=
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,app
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=9
TELEGRAM_INTERNAL_API_TOKEN=change-me-telegram-internal-token

# Django
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DEBUG=False
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Database
DATABASE_ENGINE=mysql
DATABASE_NAME=dockerdjango
DATABASE_USERNAME=admin
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=3306
REDIS_URL=redis://redis:6379/0
TWOFA_CODE_TTL_SECONDS=300
TWOFA_VERIFY_MAX_ATTEMPTS=6
TWOFA_RESEND_COOLDOWN_SECONDS=60
BACKGROUND_JOB_STALE_TIMEOUT_SECONDS=1800
TRUST_X_FORWARDED_FOR=False
SCHEDULE_SYNC_MIN_ENTRIES=1
SCHEDULE_SYNC_MIN_EXISTING_RATIO=0.5

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me

# Leave empty to keep secure TLS only in production.
# In DEBUG mode the application may still try insecure fallback for BNTU auth.
BNTU_ALLOW_INSECURE_SSL=
